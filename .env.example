# Native systemd deployment: copy this file to /etc/superset/superset.env,
# replace every CHANGE_ME value, then keep it root-owned and unreadable to
# other users (see deployment/systemd/superset.service, which loads it via
# EnvironmentFile=). Do not commit a filled-in copy of this file.
# URL-escape reserved characters (: / ? # [ ] @ %) in SUPERSET_DATABASE_URI.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Flask session/CSRF signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=CHANGE_ME__GENERATE_A_RANDOM_32BYTE_HEX_VALUE

# PostgreSQL. This is the native PostgreSQL server already running on this
# host (postgresql.service) - same one diggies-api and morning-shift use -
# so this connects over loopback, not a public address. Dedicated
# `superset` role + `superset_metadata` database only; see
# deployment/README.md for the exact createuser/createdb/GRANT commands.
# Superset's documented/default PostgreSQL driver is psycopg2 (not psycopg3
# - diggies-api uses psycopg3, but that's a per-service choice, not a
# convention to match here): keep the +psycopg2 dialect below.
SUPERSET_DATABASE_URI=postgresql+psycopg2://superset:CHANGE_ME__URL_ENCODED_POSTGRES_PASSWORD@127.0.0.1:5432/superset_metadata

# ---------------------------------------------------------------------------
# Redis - new on this host, nothing else here uses it yet. Defaults assume
# `apt install redis-server` left at its default loopback-only bind.
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# BigQuery
# ---------------------------------------------------------------------------
# Path to the dedicated read-only service account key for the reporting
# views, deployed out-of-band (scp/secret manager - never committed, never
# packaged). Root-owned, group-readable only by the superset service
# account. See deployment/README.md for the exact permissions to set.
GOOGLE_APPLICATION_CREDENTIALS=/etc/superset/bq-service-account.json
